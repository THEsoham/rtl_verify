# Ollama configuration
OLLAMA_HOST=http://localhost:11434
DESIGNER_MODEL=qwen2.5-coder:7b
VERIFIER_MODEL=qwen2.5-coder:7b

# Pipeline defaults
MAX_ITERATIONS=10
COVERAGE_THRESHOLD=80.0
MUTATION_SCORE_THRESHOLD=60.0

# Verification tools (WSL2 paths)
IVERILOG_PATH=iverilog
VVP_PATH=vvp
VERILATOR_PATH=verilator

# Database
DATABASE_URL=sqlite+aiosqlite:///./workdir/rtl_verify.db

# Working directory for run artifacts
WORK_DIR=./workdir

# Logging
LOG_LEVEL=INFO
